# Copy to .env (git-ignored) and fill in. Never commit a real key.
ANTHROPIC_API_KEY=your-key-here

# Two independent readers: use two DIFFERENT models so their mistakes are uncorrelated.
# Both must support forced tool use (tool_choice) and must not run with extended thinking.
MODEL=claude-sonnet-5-5
MODEL_B=claude-haiku-5-5
